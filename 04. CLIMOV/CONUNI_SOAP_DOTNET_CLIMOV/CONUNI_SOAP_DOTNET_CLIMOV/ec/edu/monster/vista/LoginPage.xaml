<?xml version="1.0" encoding="utf-8" ?>
<!-- Login con estilo Bento: tarjetas redondeadas sobre fondo cálido, igual que la web. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ec.edu.monster.vista.LoginPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F1EFE8">

    <ScrollView>
        <VerticalStackLayout Padding="16,32,16,24" Spacing="12">

            <!-- Marca -->
            <Border Padding="20" BackgroundColor="#26215C" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Label Text="⇄" FontSize="34" FontAttributes="Bold" TextColor="#9FE1CB" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Monsters Inc. Converter" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Cliente móvil · SOAP .NET" FontSize="13" TextColor="#CECBF6" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Imagen completa (AspectFit no recorta) -->
            <Border BackgroundColor="#26215C" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="0">
                <Image Source="monster.jpg" Aspect="AspectFit" HeightRequest="260" />
            </Border>

            <!-- Formulario -->
            <Border Padding="20" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Iniciar sesión" FontSize="20" FontAttributes="Bold" TextColor="#2C2C2A" />

                    <Label Text="Usuario" FontSize="13" TextColor="#6F6E68" Margin="0,6,0,0" />
                    <Entry x:Name="TxtUsuario" Placeholder="monster" ReturnType="Next" />

                    <Label Text="Clave" FontSize="13" TextColor="#6F6E68" />
                    <Entry x:Name="TxtClave" IsPassword="True" Placeholder="••••••" ReturnType="Go"
                           Completed="OnIngresarClicked" />

                    <Label x:Name="LblError" IsVisible="False" TextColor="#A32D2D" FontSize="14" />

                    <Button x:Name="BtnIngresar" Text="Ingresar" Clicked="OnIngresarClicked"
                            BackgroundColor="#3C3489" TextColor="White" CornerRadius="12"
                            FontAttributes="Bold" HeightRequest="50" Margin="0,6,0,0" />
                    <ActivityIndicator x:Name="Cargando" IsRunning="False" IsVisible="False" Color="#3C3489" />
                </VerticalStackLayout>
            </Border>

            <!-- Configuración del servidor (CU08) -->
            <Border Padding="20" BackgroundColor="#E1F5EE" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Servidor SOAP" FontSize="13" FontAttributes="Bold" TextColor="#0F6E56" />
                    <Entry x:Name="TxtUrl" Keyboard="Url" FontSize="14" BackgroundColor="White" />
                    <Label FontSize="12" TextColor="#0F6E56"
                           Text="Celular real: http://IP-DE-LA-PC:8085/WSConversion.svc (misma red WiFi). Emulador: http://10.0.2.2:8085/WSConversion.svc" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
