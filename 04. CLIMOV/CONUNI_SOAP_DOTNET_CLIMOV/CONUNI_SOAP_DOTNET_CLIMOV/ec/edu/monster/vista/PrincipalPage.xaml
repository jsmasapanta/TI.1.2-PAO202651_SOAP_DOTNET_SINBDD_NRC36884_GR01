<?xml version="1.0" encoding="utf-8" ?>
<!-- Pantalla principal con estilo Bento: categorías, resultado, formulario, datos, historial e imagen
     en tarjetas de distinto tamaño, igual que la web. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ec.edu.monster.vista.PrincipalPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F1EFE8">

    <ScrollView>
        <VerticalStackLayout Padding="14,28,14,20" Spacing="12">

            <!-- Barra superior -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#26215C" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                    <Label Text="⇄" FontSize="20" TextColor="#9FE1CB" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Monsters Inc. Converter" FontSize="18" FontAttributes="Bold" TextColor="#26215C" />
                    <Label x:Name="LblUsuario" FontSize="12" TextColor="#6F6E68" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="Salir" Clicked="OnCerrarSesionClicked"
                        BackgroundColor="White" TextColor="#26215C" BorderColor="#E3E0D6" BorderWidth="1"
                        CornerRadius="12" FontSize="13" HeightRequest="38" Padding="14,0" VerticalOptions="Center" />
            </Grid>

            <!-- Categorías -->
            <Border Padding="14" BackgroundColor="#26215C" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Categoría" FontSize="13" TextColor="#CECBF6" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button x:Name="BtnTemperatura" Grid.Column="0" Text="°C  Temperatura" FontSize="15" FontAttributes="Bold" CornerRadius="14" HeightRequest="56" Clicked="OnCategoriaClicked" />
                        <Button x:Name="BtnLongitud" Grid.Column="1" Text="m  Longitud" FontSize="15" FontAttributes="Bold" CornerRadius="14" HeightRequest="56" Clicked="OnCategoriaClicked" />
                        <Button x:Name="BtnMasa" Grid.Column="2" Text="kg  Masa" FontSize="15" FontAttributes="Bold" CornerRadius="14" HeightRequest="56" Clicked="OnCategoriaClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Resultado: la tarjeta protagonista -->
            <Border x:Name="CeldaResultado" Padding="20" StrokeThickness="0" StrokeShape="RoundRectangle 20" MinimumHeightRequest="140">
                <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label x:Name="LblTitulo" FontSize="13" />
                    <Label x:Name="LblResultado" Text="—" FontSize="44" FontAttributes="Bold" />
                    <Label x:Name="LblDetalle" FontSize="13" TextColor="#2C2C2A" />
                </VerticalStackLayout>
            </Border>

            <!-- Formulario de conversión -->
            <Border Padding="18" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Conversión" FontSize="13" TextColor="#6F6E68" />
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                        <VerticalStackLayout>
                            <Label Text="De" FontSize="13" FontAttributes="Bold" TextColor="#6F6E68" />
                            <Picker x:Name="PkrOrigen" Title="Unidad de origen" ItemDisplayBinding="{Binding Texto}" SelectedIndexChanged="OnOrigenCambiado" />
                        </VerticalStackLayout>
                        <Button x:Name="BtnIntercambiar" Grid.Column="1" Text="⇄" Clicked="OnIntercambiarClicked"
                                FontSize="20" WidthRequest="48" HeightRequest="48" CornerRadius="12" Padding="0" VerticalOptions="End" />
                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="A" FontSize="13" FontAttributes="Bold" TextColor="#6F6E68" />
                            <Picker x:Name="PkrDestino" Title="Unidad de destino" ItemDisplayBinding="{Binding Texto}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Valor" FontSize="13" FontAttributes="Bold" TextColor="#6F6E68" Margin="0,6,0,0" />
                    <Entry x:Name="TxtValor" Keyboard="Numeric" Placeholder="Ej.: 36,5" FontSize="20" ReturnType="Go"
                           Completed="OnConvertirClicked" />

                    <Button x:Name="BtnConvertir" Text="Convertir" Clicked="OnConvertirClicked"
                            TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="52" Margin="0,8,0,0" />
                    <ActivityIndicator x:Name="Cargando" IsRunning="False" IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <!-- Datos pequeños -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Padding="16" BackgroundColor="#E1F5EE" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Conversiones" FontSize="13" TextColor="#0F6E56" />
                        <Label x:Name="LblContador" Text="0" FontSize="34" FontAttributes="Bold" TextColor="#0F6E56" />
                        <Label x:Name="LblContadorPie" FontSize="12" TextColor="#0F6E56" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Servidor SOAP" FontSize="13" TextColor="#6F6E68" />
                        <HorizontalStackLayout Spacing="6">
                            <Ellipse WidthRequest="10" HeightRequest="10" Fill="#1D9E75" VerticalOptions="Center" />
                            <Label Text="Conectado" FontAttributes="Bold" TextColor="#2C2C2A" />
                        </HorizontalStackLayout>
                        <Label x:Name="LblServidor" FontSize="11" TextColor="#6F6E68" LineBreakMode="CharacterWrap" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Historial (CU06) e imagen completa -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Historial" FontSize="13" TextColor="#6F6E68" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Limpiar" Clicked="OnLimpiarClicked" FontSize="12"
                                    BackgroundColor="Transparent" TextColor="#6F6E68" HeightRequest="32" Padding="6,0" />
                        </Grid>
                        <Label x:Name="LblHistorialVacio" Text="Aún no hay conversiones."
                               FontSize="13" TextColor="#6F6E68" />
                        <VerticalStackLayout x:Name="ListaHistorial" Spacing="4" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#26215C" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="0">
                    <Image Source="monster.jpg" Aspect="AspectFit" HeightRequest="220" />
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
