<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ec.edu.monster.vista.PrincipalPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Fondo}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Encabezado -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="20,36,12,16" ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
                <Label Text="⇄ Conversor" FontSize="24" FontAttributes="Bold" TextColor="White" />
                <Label x:Name="LblUsuario" FontSize="13" TextColor="#D9EDE7" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Salir" Clicked="OnCerrarSesionClicked"
                    BackgroundColor="#A93226" TextColor="White" FontSize="13"
                    HeightRequest="38" Padding="14,0" VerticalOptions="Center" />
        </Grid>

        <!-- Categorías -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8" Padding="12,12,12,4">
            <Button x:Name="BtnTemperatura" Grid.Column="0" Text="°C  Temperatura" FontSize="12" Clicked="OnCategoriaClicked" />
            <Button x:Name="BtnLongitud" Grid.Column="1" Text="m  Longitud" FontSize="12" Clicked="OnCategoriaClicked" />
            <Button x:Name="BtnMasa" Grid.Column="2" Text="kg  Masa" FontSize="12" Clicked="OnCategoriaClicked" />
        </Grid>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="12" Spacing="12">

                <!-- Tarjeta de conversión -->
                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="LblTitulo" FontSize="22" FontAttributes="Bold" />

                        <Label Text="De" FontAttributes="Bold" TextColor="{StaticResource Texto}" />
                        <Picker x:Name="PkrOrigen" Title="Unidad de origen" ItemDisplayBinding="{Binding Texto}" SelectedIndexChanged="OnOrigenCambiado" />

                        <Button x:Name="BtnIntercambiar" Text="⇅  Intercambiar" Clicked="OnIntercambiarClicked"
                                HorizontalOptions="Center" FontSize="13" HeightRequest="40" Padding="16,0" />

                        <Label Text="A" FontAttributes="Bold" TextColor="{StaticResource Texto}" />
                        <Picker x:Name="PkrDestino" Title="Unidad de destino" ItemDisplayBinding="{Binding Texto}" />

                        <Label Text="Valor" FontAttributes="Bold" TextColor="{StaticResource Texto}" Margin="0,4,0,0" />
                        <Entry x:Name="TxtValor" Keyboard="Numeric" Placeholder="Ej.: 36,5" ReturnType="Go"
                               Completed="OnConvertirClicked" />

                        <Button x:Name="BtnConvertir" Text="CONVERTIR" Clicked="OnConvertirClicked"
                                TextColor="White" FontAttributes="Bold" HeightRequest="50" />
                        <ActivityIndicator x:Name="Cargando" IsRunning="False" IsVisible="False" />

                        <BoxView HeightRequest="1" Color="{StaticResource Borde}" Margin="0,6" />
                        <Label x:Name="LblResultado" Text="—" FontSize="30" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="LblDetalle" FontSize="13" TextColor="{StaticResource TextoSuave}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Historial (CU06) -->
                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Historial de la sesión" FontAttributes="Bold" FontSize="16"
                                   TextColor="{StaticResource Texto}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Limpiar" Clicked="OnLimpiarClicked" FontSize="12"
                                    BackgroundColor="#6C757D" TextColor="White" HeightRequest="34" Padding="12,0" />
                        </Grid>
                        <Label x:Name="LblHistorialVacio" Text="Aún no hay conversiones en esta categoría."
                               FontSize="13" TextColor="{StaticResource TextoSuave}" />
                        <VerticalStackLayout x:Name="ListaHistorial" Spacing="4" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="0" StrokeShape="RoundRectangle 14">
                    <Image Source="monster.jpg" Aspect="AspectFill" HeightRequest="220" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
