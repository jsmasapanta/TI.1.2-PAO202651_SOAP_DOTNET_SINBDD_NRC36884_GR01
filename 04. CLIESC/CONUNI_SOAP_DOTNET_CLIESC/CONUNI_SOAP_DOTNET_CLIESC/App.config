<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="ConversionBinding" openTimeout="00:00:10" sendTimeout="00:00:15" receiveTimeout="00:00:15" />
      </basicHttpBinding>
    </bindings>
    <client>
      <!-- Cambiar SOLO esta dirección para apuntar a otro servidor (por ejemplo http://192.168.1.10:8085/WSConversion.svc). -->
      <endpoint name="WSConversion"
                address="http://localhost:8085/WSConversion.svc"
                binding="basicHttpBinding"
                bindingConfiguration="ConversionBinding"
                contract="ConversorUnidades.Escritorio.Servicio.IWSConversion" />
    </client>
  </system.serviceModel>
</configuration>
