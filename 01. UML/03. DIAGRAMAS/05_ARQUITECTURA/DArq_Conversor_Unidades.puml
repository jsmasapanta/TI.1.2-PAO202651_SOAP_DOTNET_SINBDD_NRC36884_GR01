@startuml DArq_Conversor_Unidades
!include ../_estilo.iuml
title Diagrama de arquitectura — Conversor de Unidades SOAP .NET (sin BDD)

node "PC del usuario" {
  component "CLICON\nConsola .NET Fw 4.7.2\n(ChannelFactory)" as CLICON
  component "CLIESC\nWindows Forms .NET Fw 4.7.2\n(ChannelFactory)" as CLIESC
}

node "Navegador web" {
  component "Interfaz HTML/CSS/JS" as HTML
}

node "Servidor web cliente\n(Kestrel :5085)" {
  component "CLIWEB\nASP.NET Core MVC .NET 8\n(System.ServiceModel.Http)" as CLIWEB
}

node "Celular / tablet Android" {
  component "CLIMOV\n.NET MAUI (C#)\n(HttpClient + XDocument)" as CLIMOV
}

node "Servidor IIS :8085" {
  component "WSConversion.svc\nWCF basicHttpBinding\nSOAP 1.1" as SVC
  package "ConversorUnidades.Servidor" {
    component "Contratos\nIWSConversion · ErrorServicio" as CONTR
    component "Servicios\nWSConversion" as SERV
    component "Lógica\nConvertidores · Validación · Autenticador" as LOG
  }
  file "Web.config\n(credenciales monster,\nendpoint)" as CFG
}

HTML --> CLIWEB : HTTP (formularios)
CLICON --> SVC : SOAP / HTTP
CLIESC --> SVC : SOAP / HTTP
CLIWEB --> SVC : SOAP / HTTP
CLIMOV --> SVC : SOAP / HTTP
SVC --> SERV
SERV ..|> CONTR
SERV --> LOG
LOG ..> CFG : lee usuario y clave

note bottom of SVC
  WSDL: http://servidor:8085/WSConversion.svc?wsdl
  Namespace: http://espe.edu.ec/conuni/
  Errores: SOAP Fault con ErrorServicio
end note
@enduml
