' Estilo común de todos los diagramas (mismos colores que los clientes).
!pragma layout smetana
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 8
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #004A38
skinparam ArrowFontColor #212529
skinparam ActorBorderColor #004A38
skinparam ActorBackgroundColor #E6F2EF
skinparam UsecaseBorderColor #006950
skinparam UsecaseBackgroundColor #E6F2EF
skinparam RectangleBorderColor #004A38
skinparam PackageBorderColor #004A38
skinparam PackageBackgroundColor #FAFCFB
skinparam ComponentBorderColor #006950
skinparam ComponentBackgroundColor #E6F2EF
skinparam NodeBorderColor #004A38
skinparam NodeBackgroundColor #F3F6F5
skinparam ClassBorderColor #006950
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #E6F2EF
skinparam NoteBorderColor #C9A227
skinparam NoteBackgroundColor #FFF8DC
skinparam ParticipantBorderColor #006950
skinparam ParticipantBackgroundColor #E6F2EF
skinparam SequenceLifeLineBorderColor #6C757D
skinparam ActivityBorderColor #006950
skinparam ActivityBackgroundColor #E6F2EF
skinparam ActivityDiamondBorderColor #004A38
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam PartitionBorderColor #004A38
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
