@startuml DA_Realizar_Conversion
!include ../_estilo.iuml
title Diagrama de actividad — CU02/CU03/CU04 Realizar una conversión

|Usuario|
start
:Elegir categoría\n(Temperatura, Longitud o Masa);
|Cliente|
:Cargar unidades de origen\ndel catálogo de la categoría;
:Cargar en "A" solo las unidades\nconvertibles desde "De";
|Usuario|
repeat
  :Elegir unidades "De" y "A";
  if (¿Quiere intercambiarlas?) then (sí)
    :Presionar el botón Intercambiar;
    |Cliente|
    :Intercambiar "De" y "A";
    |Usuario|
  endif
  :Escribir el valor y presionar Convertir;
  |Cliente|
  :Leer número (acepta coma o punto);
  if (¿Es un número válido?) then (no)
    :Mostrar "Ingrese un número válido";
  else (sí)
    :Invocar operación SOAP\n(p. ej. **celsiusAFahrenheit(valor)**);
    |Servidor WSConversion|
    :Validar valor\n(cero absoluto / no negativo);
    if (¿Valor físicamente posible?) then (sí)
      :Calcular con factor exacto;
      :Responder resultado;
      |Cliente|
      :Mostrar resultado con hasta 6 decimales;
      :Agregar al historial de la sesión;
    else (no)
      |Servidor WSConversion|
      :Responder SOAP Fault\n<<ErrorServicio>> VALOR_INVALIDO;
      |Cliente|
      :Mostrar el mensaje del servidor en rojo;
    endif
  endif
  |Usuario|
repeat while (¿Otra conversión?) is (sí)
-> no;
stop
@enduml
