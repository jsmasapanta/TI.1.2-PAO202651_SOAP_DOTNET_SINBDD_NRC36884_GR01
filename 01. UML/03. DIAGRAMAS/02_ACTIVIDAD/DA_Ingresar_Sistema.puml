@startuml DA_Ingresar_Sistema
!include ../_estilo.iuml
title Diagrama de actividad — CU01 Ingresar al sistema (los intentos los controla el servidor)

|Usuario|
start
:Abre el cliente;
|Cliente (vista + controlador)|
:Muestra el login y el servidor;
repeat
  |Usuario|
  :Escribe usuario y clave;
  |Cliente (vista + controlador)|
  :Envía login(usuario, clave);
  |Servidor WSConversion|
  if (¿campos vacíos?) then (sí)
    :Fault «Ingrese usuario y clave.»;
  elseif (¿usuario bloqueado?) then (sí)
    :Fault «Usuario bloqueado por superar 3 intentos.\nIntente de nuevo en N segundos.»;
  else (no)
    :Compara con UsuarioServicio y ClaveServicio (Web.config);
    if (¿coinciden?) then (sí)
      :Reinicia los intentos del usuario;
      :Devuelve true;
      |Cliente (vista + controlador)|
      :Guarda el usuario de la sesión;
      :Muestra el menú principal;
      stop
    else (no)
      |Servidor WSConversion|
      :intentos + 1;
      if (¿intentos = 3?) then (sí)
        :Bloquea al usuario 2 minutos;
        :Fault «Se superaron los 3 intentos.\nEl usuario queda bloqueado 2 minutos.»;
      else (no)
        :Fault «Usuario o clave incorrectos.\nIntentos restantes: N.»;
      endif
    endif
  endif
  |Cliente (vista + controlador)|
  :Muestra el mensaje del servidor;
repeat while (¿intenta de nuevo?) is (sí) not (no)
stop
@enduml
