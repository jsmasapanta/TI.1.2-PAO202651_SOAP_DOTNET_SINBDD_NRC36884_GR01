@startuml DCU_Conversor_Unidades
!include ../_estilo.iuml
title Diagrama de casos de uso — Sistema de Conversión de Unidades (SOAP .NET sin BDD)
left to right direction

actor "Usuario" as Usuario
actor "Servicio SOAP\nWSConversion" as Servicio <<sistema>>

rectangle "Clientes: Consola · Escritorio · Web · Móvil" {
  usecase "CU01\nIngresar al sistema" as CU01
  usecase "Realizar conversión" as RC
  usecase "CU02\nConvertir temperatura" as CU02
  usecase "CU03\nConvertir longitud" as CU03
  usecase "CU04\nConvertir masa" as CU04
  usecase "Validar valor\nde entrada" as VAL
  usecase "CU05\nIntercambiar unidades" as CU05
  usecase "CU06\nConsultar historial\nde la sesión" as CU06
  usecase "CU07\nCerrar sesión" as CU07
  usecase "CU08\nConfigurar servidor\n(solo móvil)" as CU08
}

Usuario --> CU01
Usuario --> RC
Usuario --> CU06
Usuario --> CU07
Usuario --> CU08

CU02 -up-|> RC
CU03 -up-|> RC
CU04 -up-|> RC
RC ..> VAL : <<include>>
CU05 ..> RC : <<extend>>

CU01 --> Servicio
RC --> Servicio

@enduml
