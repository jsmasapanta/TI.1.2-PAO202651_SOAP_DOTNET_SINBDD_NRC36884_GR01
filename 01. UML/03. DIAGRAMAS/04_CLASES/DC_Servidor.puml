@startuml DC_Servidor
!include ../_estilo.iuml
title Diagrama de clases — SERVIDOR (ConversorUnidades.Servidor)

package "Contratos" {
  interface IWSConversion <<ServiceContract WSConversion>> {
    + Login(usuario : string, clave : string) : bool
    + CelsiusAFahrenheit(valor : double) : double
    + FahrenheitACelsius(valor : double) : double
    + CelsiusAKelvin(valor : double) : double
    + KelvinACelsius(valor : double) : double
    + FahrenheitAKelvin(valor : double) : double
    + KelvinAFahrenheit(valor : double) : double
    + MetrosAPies(valor : double) : double
    + PiesAMetros(valor : double) : double
    + MetrosAPulgadas(valor : double) : double
    + PulgadasAMetros(valor : double) : double
    + KilometrosAMillas(valor : double) : double
    + MillasAKilometros(valor : double) : double
    + KilogramosALibras(valor : double) : double
    + LibrasAKilogramos(valor : double) : double
    + GramosAOnzas(valor : double) : double
    + OnzasAGramos(valor : double) : double
  }
  class ErrorServicio <<DataContract>> {
    + Codigo : string
    + Mensaje : string
  }
  class Constantes <<static>> {
    + NamespaceServicio : string = "http://espe.edu.ec/conuni/"
  }
}

package "Servicios" {
  class WSConversion <<ServiceBehavior>> {
    + Login(usuario, clave) : bool
    + CelsiusAFahrenheit(valor) : double
    + ... (16 conversiones)
    - Ejecutar<T>(operacion : Func<T>) : T
  }
}

package "Logica" {
  class ConvertidorTemperatura <<static>> {
    + CeroAbsolutoCelsius = -273.15
    + CeroAbsolutoFahrenheit = -459.67
    + CeroAbsolutoKelvin = 0
    + CelsiusAFahrenheit(c) : double
    + FahrenheitACelsius(f) : double
    + CelsiusAKelvin(c) : double
    + KelvinACelsius(k) : double
    + FahrenheitAKelvin(f) : double
    + KelvinAFahrenheit(k) : double
    - Validar(valor, minimo, unidad)
  }
  class ConvertidorLongitud <<static>> {
    + MetrosPorPie = 0.3048
    + MetrosPorPulgada = 0.0254
    + KilometrosPorMilla = 1.609344
    + MetrosAPies(m) : double
    + PiesAMetros(ft) : double
    + MetrosAPulgadas(m) : double
    + PulgadasAMetros(in) : double
    + KilometrosAMillas(km) : double
    + MillasAKilometros(mi) : double
  }
  class ConvertidorMasa <<static>> {
    + KilogramosPorLibra = 0.45359237
    + GramosPorOnza = 28.349523125
    + KilogramosALibras(kg) : double
    + LibrasAKilogramos(lb) : double
    + GramosAOnzas(g) : double
    + OnzasAGramos(oz) : double
  }
  class Validacion <<static>> {
    + ValidarNumero(valor)
    + ValidarNoNegativo(valor, magnitud)
  }
  class Autenticador <<singleton>> {
    - {static} instancia : Lazy<Autenticador>
    - usuarioValido : string
    - claveValida : string
    + {static} Instancia : Autenticador
    - Autenticador()
    + Validar(usuario, clave) : bool
  }
}

WSConversion ..|> IWSConversion
WSConversion ..> ErrorServicio : lanza FaultException<ErrorServicio>
WSConversion ..> ConvertidorTemperatura
WSConversion ..> ConvertidorLongitud
WSConversion ..> ConvertidorMasa
WSConversion ..> Autenticador : Autenticador.Instancia
ConvertidorTemperatura ..> Validacion
ConvertidorLongitud ..> Validacion
ConvertidorMasa ..> Validacion
IWSConversion ..> Constantes
@enduml
