@startuml DS_Realizar_Conversion
!include ../_estilo.iuml
title Diagrama de secuencia — CU02 Convertir temperatura (igual para longitud y masa)
autonumber

actor Usuario
participant "Vista\n(PanelConversion / Index.cshtml /\nPrincipalActivity)" as Vista
participant "Controlador" as Ctrl
participant "CatalogoConversiones" as Cat
participant "ClienteConversion\n(proxy SOAP)" as Proxy
participant "WSConversion\n(.svc en IIS)" as WS
participant "ConvertidorTemperatura" as Conv

Usuario -> Vista : elige °C → °F, escribe 100, Convertir
Vista -> Ctrl : leerNumero("100")
Ctrl --> Vista : 100.0
Vista -> Cat : Buscar("°C", "°F")
Cat --> Vista : Conversion(operación = celsiusAFahrenheit)
Vista -> Ctrl : convertir(conversion, 100.0)
Ctrl -> Proxy : CelsiusAFahrenheit(100.0)
Proxy -> WS : POST SOAP <celsiusAFahrenheit><valor>100</valor>
WS -> Conv : CelsiusAFahrenheit(100.0)
alt valor >= -273.15 °C
  Conv --> WS : 212.0
  WS --> Proxy : <celsiusAFahrenheitResult>212</...>
  Proxy --> Ctrl : 212.0
  Ctrl -> Ctrl : formatear y guardar en historial
  Ctrl --> Vista : "212 °F"
  Vista --> Usuario : muestra 212 °F y lo agrega al historial
else valor < cero absoluto
  Conv --> WS : ArgumentOutOfRangeException
  WS --> Proxy : SOAP Fault <ErrorServicio>\nVALOR_INVALIDO + Mensaje
  Proxy --> Ctrl : ErrorConversionException(Mensaje)
  Ctrl --> Vista : mensaje de error
  Vista --> Usuario : "La temperatura no puede ser menor\nal cero absoluto (-273.15 °C)."
end
@enduml
