<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <appSettings>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
    <!-- Credenciales del servicio (proyecto sin base de datos). Cambiarlas aquí, no en el código. -->
    <add key="UsuarioServicio" value="monster" />
    <add key="ClaveServicio" value="monster" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
  </system.web>

  <system.serviceModel>
    <services>
      <service name="ConversorUnidades.Servidor.Servicios.WSConversion">
        <endpoint address="" binding="basicHttpBinding"
                  bindingNamespace="http://espe.edu.ec/conuni/"
                  contract="ConversorUnidades.Servidor.Contratos.IWSConversion" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior>
          <!-- Publica el WSDL en .../WSConversion.svc?wsdl -->
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <!-- Los errores de validación se envían como FaultException<ErrorServicio>; no exponer detalles internos. -->
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" minFreeMemoryPercentageToActivateService="0" />
  </system.serviceModel>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <directoryBrowse enabled="false" />
    <defaultDocument>
      <files>
        <clear />
        <add value="WSConversion.svc" />
      </files>
    </defaultDocument>
  </system.webServer>

</configuration>
